---
import '@/styles/global.css'
import BaseHead from '@/components/layout/BaseHead.astro'
import Header from '@/components/layout/Header.astro'
import Footer from '@/components/layout/Footer.astro'
import BaseLayout from '@/layouts/BaseLayout.astro'
import GradientMask from '@/components/ui/GradientMask.astro'
import { themeConfig } from '@/config'

const { title, description, entrance = false } = Astro.props
---

<BaseLayout title={title} description={description} type="page">
  <BaseHead title={title} description={description} slot="head" />
  <div class="page-content" data-index-entrance={entrance || undefined}>
    <GradientMask />
    <div data-index-step="0">
      <slot name="header">
        <Header />
      </slot>
    </div>
    <main>
      <slot />
    </main>
    {themeConfig.general.footer && (
      <div data-index-step="4">
        <Footer />
      </div>
    )}
  </div>
</BaseLayout>

<style is:global>
  .page-content {
    flex: 1;
    display: flex;
    flex-direction: column;
  }

  .page-content main {
    flex: 1;
  }

  @media (prefers-reduced-motion: no-preference) {
    [data-index-entrance] [data-index-step] {
      animation: index-enter 600ms ease both;
      animation-delay: calc(var(--index-step, 0) * 120ms);
    }

    [data-index-step='1'] {
      --index-step: 1;
    }
    [data-index-step='2'] {
      --index-step: 2;
    }
    [data-index-step='3'] {
      --index-step: 3;
    }
    [data-index-step='4'] {
      --index-step: 4;
    }
  }

  @keyframes index-enter {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
</style>
