    "astro-og-canvas": "^0.13.2",
    "canvaskit-wasm": "^0.42.0",
    "feed": "^6.0.0",
    "katex": "^0.19.1",
    "markdown-it": "^15.0.3",
    "mdast-util-to-string": "^4.0.0",
    "node-html-parser": "^9.0.5",
    "reading-time": "^1.5.0",
    "sanitize-html": "^2.18.1",
    "satteri": "^0.11.6",
