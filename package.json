  "packageManager": "bun@1.4.4-canary.1",
  "scripts": {
    "dev": "bun scripts/render-papers.ts && astro dev",
    "build": "bun scripts/render-papers.ts && astro build",
    "typecheck": "astro check",
    "check": "bun lint && bun run typecheck && bun run build && bun test",
