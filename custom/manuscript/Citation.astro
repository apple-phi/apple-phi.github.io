---
interface Props {
  bibtex: string
  arxiv: string
}
const { bibtex, arxiv } = Astro.props
---

<div class="manuscript-citation">
  <div class="manuscript-actions">
    <a href={arxiv}>[arXiv]</a>
    <button type="button" class="citation-toggle" aria-haspopup="dialog">
      [BibTeX]
    </button>
  </div>
  <template class="citation-template">
    <div class="citation-content">
      <p id="citation-hint" class="citation-hint">
        Click the entry to select it all.
      </p>
      <pre
        class="citation-entry"
        tabindex="0"
        role="button"
        aria-label="Select the full BibTeX entry"
        aria-describedby="citation-hint"
      ><code>{bibtex}</code></pre>
    </div>
  </template>
</div>

<script>
  import tippy, { hideAll, type Instance } from 'tippy.js'
  import 'tippy.js/dist/tippy.css'

  let destroy: (() => void) | undefined

  function bindCitation() {
    destroy?.()
    const events = new AbortController()
    const instances: Instance[] = []
    document.querySelectorAll<HTMLElement>('.manuscript-citation').forEach((citation) => {
      citation.dataset.bound = 'true'
      const toggle = citation.querySelector<HTMLButtonElement>('.citation-toggle')!
      const template = citation.querySelector<HTMLTemplateElement>('.citation-template')!
      const content = template.content.firstElementChild!.cloneNode(true) as HTMLElement
      const entry = content.querySelector<HTMLElement>('.citation-entry')!
      const instance = tippy(toggle, {
        content,
        trigger: 'click',
        interactive: true,
        appendTo: () => document.body,
        theme: 'manuscript',
        role: 'dialog',
        aria: { content: null, expanded: true },
        placement: 'bottom-start',
        maxWidth: 512,
        arrow: false,
        duration: 0,
        popperOptions: {
          strategy: 'fixed',
          modifiers: [
            { name: 'preventOverflow', options: { padding: 12, altAxis: true } },
            { name: 'flip', options: { padding: 12 } }
          ]
        },
        onShow(instance) {
          hideAll({ exclude: instance })
        },
        onMount(instance) {
          instance.popper.querySelector('[role="dialog"]')?.setAttribute('aria-label', 'BibTeX citation')
          toggle.setAttribute('aria-controls', instance.popper.id)
          entry.focus({ preventScroll: true })
        },
        onHidden() {
          toggle.removeAttribute('aria-controls')
        }
      })
      instances.push(instance)
      const selectEntry = () => {
        const range = document.createRange()
        range.selectNodeContents(entry.querySelector('code')!)
        const selection = window.getSelection()
        selection?.removeAllRanges()
        selection?.addRange(range)
      }
      entry.addEventListener('click', selectEntry, { signal: events.signal })
      entry.addEventListener(
        'keydown',
        (event) => {
          if (event.key === 'Enter' || event.key === ' ') {
            event.preventDefault()
            selectEntry()
          }
        },
        { signal: events.signal }
      )
      document.addEventListener(
        'keydown',
        (event) => {
          if (!instance.state.isVisible) return
          if (event.key === 'Escape') {
            event.preventDefault()
            const restoreFocus = instance.popper.contains(document.activeElement)
            instance.hide()
            if (restoreFocus) toggle.focus({ preventScroll: true })
          } else if (event.key === 'Tab' && instance.popper.contains(document.activeElement)) {
            instance.hide()
            toggle.focus({ preventScroll: true })
            if (event.shiftKey) event.preventDefault()
          }
        },
        { signal: events.signal }
      )
    })
    destroy = () => {
      events.abort()
      instances.forEach((instance) => instance.destroy())
    }
  }
  document.addEventListener('astro:page-load', bindCitation)
  document.addEventListener('astro:before-swap', () => {
    destroy?.()
    destroy = undefined
  })
</script>

<style>
  .manuscript-actions {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    margin-top: 0.75rem;
    font-size: var(--font-size-s);
  }
  button {
    padding: 0;
    border: 0;
    background: none;
    color: var(--text-primary);
    font: inherit;
    cursor: pointer;
    text-decoration: underline;
    text-decoration-color: var(--text-tertiary);
    text-underline-offset: 0.12em;
  }
  button:hover {
    text-decoration-color: var(--text-primary);
  }
  .citation-content .citation-hint {
    margin: 0 0 0.5rem;
    font-size: var(--font-size-s);
    color: var(--text-secondary);
    text-align: left;
  }
  pre {
    margin: 0;
    padding: 0;
    font-family: var(--mono);
    font-size: var(--font-size-s);
    line-height: 1.6;
    letter-spacing: 0;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
    cursor: text;
    user-select: all;
  }
  pre:focus-visible {
    outline: 1px solid var(--text-secondary);
    outline-offset: 3px;
  }
  .citation-content code {
    font-family: inherit;
    font-size: inherit;
    white-space: inherit;
  }
</style>
